{
  "name": "animic",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check && vp exec tsc --noEmit && vp exec knip",
    "format": "vp fmt",
    "hooks:setup": "vp hooks enable",
    "icons:generate": "node scripts/generate-icons.mjs",
    "commitlint": "commitlint",
    "lint": "vp lint",
    "format:check": "vp fmt --check",
    "knip": "vp exec knip",
    "dev": "vp dev .",
    "dev:mock": "node scripts/mock-server.mjs",
    "build": "vp build .",
    "preview": "vp preview .",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "vp test run --config vitest.config.ts",
    "ds:codegen": "panda codegen --spec",
    "prepare": "panda codegen --spec",
    "test:visual": "ANIMIC_VISUAL=true playwright test --project=visual",
    "test:visual:update": "ANIMIC_VISUAL=true playwright test --project=visual --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o dist/storybook"
  },
  "dependencies": {
    "@animic/react": "workspace:*",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.57",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@ark-ui/mcp": "1.3.0",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@cloudflare/vite-plugin": "1.57.2",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@pandacss/dev": "2.1.0",
    "@pandacss/mcp": "2.1.0",
    "@pandacss/preset-base": "2.1.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "happy-dom": "20.14.5",
    "knip": "6.37.0",
    "postcss": "8.5.28",
    "rolldown": "1.2.9",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "wrangler": "4.136.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.33.4",
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "tests/visual/**/*.spec.ts"
        ],
        "ignoreDependencies": [
          "cloudflare",
          "@pandacss/mcp",
          "@ark-ui/mcp"
        ]
      }
    }
  }
}
