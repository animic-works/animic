{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "animic",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "animic",
      "database_id": "8944c3f5-246f-41d4-b4b9-80a204952dc5",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "TOPIC_IMAGES",
      "bucket_name": "animic-topic-images",
    },
    {
      "binding": "GENERATED_IMAGES",
      "bucket_name": "animic-generated-images",
    },
  ],
  "vars": {
    "NOVELAI_API_URL": "https://image.novelai.net",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "NOVELAI_API_TOKEN",
      "NOVELAI_STYLE_PROMPT",
      "ADMIN_PASSWORD",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
      {
        "name": "NOVELAI_QUEUE",
        "class_name": "NovelAiQueue",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["NovelAiQueue"],
    },
  ],
}
