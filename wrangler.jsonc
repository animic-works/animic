{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "animic",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "animic",
      "database_id": "8944c3f5-246f-41d4-b4b9-80a204952dc5",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
}
