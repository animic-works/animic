{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "tests",
    "packages/design-system/src",
    "panda.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.design-system.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "worker-configuration.d.ts",
    "packages/react/src",
    ".storybook",
    "stories",
    "playwright.design-system.config.ts"
  ]
}
